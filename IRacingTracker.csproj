<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IRacingTracker</AssemblyName>
    <RootNamespace>IRacingTracker</RootNamespace>
    <!-- Sem .exe solto: o Controlo Inteligente de Aplicações bloqueia-o. Corre através do dotnet.exe (assinado pela Microsoft). -->
    <UseAppHost>false</UseAppHost>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
